+:root {
+  --cat-1: #0A9296;  /* فيروزي — لون الهوية، دائماً الأول */
+  --cat-2: #C2560B;  /* برتقالي */
+  --cat-3: #7C32C9;  /* بنفسجي */
+  --cat-4: #0F8A5F;  /* أخضر */
+  --cat-5: #1170C7;  /* أزرق */
+  --cat-6: #8A6D00;  /* ذهبي */
+  --cat-7: #B0106A;  /* أرجواني */
+}
+[data-theme="dark"] {
+  --cat-1: #12A0A3;
+  --cat-2: #CF6A31;
+  --cat-3: #9A62D6;
