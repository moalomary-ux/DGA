+.tint-3 { background: color-mix(in srgb, var(--cat-3) 12%, transparent); color: var(--cat-3); }
+.tint-4 { background: color-mix(in srgb, var(--cat-4) 12%, transparent); color: var(--cat-4); }
+.tint-5 { background: color-mix(in srgb, var(--cat-5) 12%, transparent); color: var(--cat-5); }
+.tint-6 { background: color-mix(in srgb, var(--cat-6) 12%, transparent); color: var(--cat-6); }
