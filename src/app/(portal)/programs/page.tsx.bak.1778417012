'use client';

import { useEffect, useState, useCallback } from 'react';
import Link from 'next/link';
import { Search, Users, Calendar, Building2, Loader2, GraduationCap } from 'lucide-react';

interface Program {
  id: number;
  title_ar: string;
  title_en: string | null;
  program_type: string | null;
  category: string | null;
  provider: string | null;
  delivery_mode: string | null;
  start_date: string | null;
  duration_hours: number | null;
  capacity: number | null;
  rating: number | null;
  year: number | null;
  attendee_count: number;
  org_count: number;
}

const CATEGORY_LABELS: Record<string, { ar: string; color: string }> = {
  AI: { ar: '🤖 الذكاء الاصطناعي', color: 'bg-purple-50 text-purple-700' },
  cybersecurity: { ar: '🛡️ الأمن السيبراني', color: 'bg-red-50 text-red-700' },
  data: { ar: '📊 البيانات', color: 'bg-blue-50 text-blue-700' },
  leadership: { ar: '👔 القيادة', color: 'bg-amber-50 text-amber-700' },
  design: { ar: '🎨 التصميم', color: 'bg-pink-50 text-pink-700' },
  cloud: { ar: '☁️ الحوسبة السحابية', color: 'bg-sky-50 text-sky-700' },
  digital_transformation: { ar: '🚀 التحوّل الرقمي', color: 'bg-emerald-50 text-emerald-700' },
  innovation: { ar: '💡 الابتكار', color: 'bg-yellow-50 text-yellow-700' },
  other: { ar: '📚 أخرى', color: 'bg-gray-50 text-gray-700' },
};

const TYPE_LABELS: Record<string, string> = {
  training: 'برنامج',
  workshop: 'ورشة',
  course: 'دورة',
  bootcamp: 'معسكر',
};

export default function ProgramsPage() {
  const [programs, setPrograms] = useState<Program[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState('');
  const [category, setCategory] = useState('');
  const [progType, setProgType] = useState('');
  const [year, setYear] = useState('');
  const [facets, setFacets] = useState({ categories: [] as string[], types: [] as string[], years: [] as number[] });
  const [offset, setOffset] = useState(0);
  const limit = 30;

  const fetchPrograms = useCallback(async () => {
    setLoading(true);
    const params = new URLSearchParams({ limit: String(limit), offset: String(offset) });
    if (search) params.set('search', search);
    if (category) params.set('category', category);
    if (progType) params.set('type', progType);
    if (year) params.set('year', year);
    const res = await fetch(`/api/programs?${params}`);
    const data = await res.json();
    if (data.ok) {
      setPrograms(data.rows);
      setTotal(data.total);
      setFacets(data.facets);
    }
    setLoading(false);
  }, [search, category, progType, year, offset]);

  useEffect(() => {
    const t = setTimeout(fetchPrograms, 250);
    return () => clearTimeout(t);
  }, [fetchPrograms]);

  return (
    <div className="p-6 max-w-[1400px] mx-auto" dir="rtl">
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900">🎓 البرامج التدريبية</h1>
        <p className="text-gray-600 mt-1">{total} برنامج · مرتّبة حسب عدد الحضور</p>
      </div>

      {/* Filters */}
      <div className="bg-white rounded-xl border border-gray-200 p-4 mb-6 flex flex-wrap gap-3">
        <div className="relative flex-1 min-w-[260px]">
          <Search className="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
          <input
            type="text"
            placeholder="ابحث في البرامج أو المزودين..."
            value={search}
            onChange={e => { setSearch(e.target.value); setOffset(0); }}
            className="w-full pr-10 pl-4 py-2 border border-gray-300 rounded-lg"
          />
        </div>
        <select value={category} onChange={e => { setCategory(e.target.value); setOffset(0); }}
                className="px-4 py-2 border rounded-lg bg-white">
          <option value="">كل التصنيفات</option>
          {facets.categories.map(c => <option key={c} value={c}>{CATEGORY_LABELS[c]?.ar || c}</option>)}
        </select>
        <select value={progType} onChange={e => { setProgType(e.target.value); setOffset(0); }}
                className="px-4 py-2 border rounded-lg bg-white">
          <option value="">كل الأنواع</option>
          {facets.types.map(t => <option key={t} value={t}>{TYPE_LABELS[t] || t}</option>)}
        </select>
        <select value={year} onChange={e => { setYear(e.target.value); setOffset(0); }}
                className="px-4 py-2 border rounded-lg bg-white">
          <option value="">كل السنوات</option>
          {facets.years.map(y => <option key={y} value={y}>{y}</option>)}
        </select>
      </div>

      {loading ? (
        <div className="flex justify-center py-12"><Loader2 className="h-8 w-8 animate-spin text-blue-500" /></div>
      ) : programs.length === 0 ? (
        <div className="text-center py-12 text-gray-500">لا توجد برامج مطابقة</div>
      ) : (
        <>
          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {programs.map(p => {
              const cat = CATEGORY_LABELS[p.category || 'other'] || CATEGORY_LABELS.other;
              return (
                <Link key={p.id} href={`/programs/${p.id}`}
                      className="bg-white rounded-xl border border-gray-200 p-5 hover:border-blue-400 hover:shadow-md transition group">
                  <div className="flex items-start gap-3 mb-3">
                    <div className="p-2 bg-blue-50 rounded-lg group-hover:bg-blue-100">
                      <GraduationCap className="h-5 w-5 text-blue-600" />
                    </div>
                    <div className="flex-1 min-w-0">
                      <h3 className="font-semibold text-gray-900 group-hover:text-blue-600 line-clamp-2 leading-tight">
                        {p.title_ar}
                      </h3>
                      {p.provider && (
                        <p className="text-xs text-gray-500 mt-1 truncate">📍 {p.provider}</p>
                      )}
                    </div>
                  </div>
                  <div className="flex flex-wrap gap-2 mb-3">
                    <span className={`px-2 py-1 text-xs rounded ${cat.color}`}>{cat.ar}</span>
                    {p.program_type && (
                      <span className="px-2 py-1 text-xs bg-gray-50 text-gray-600 rounded">
                        {TYPE_LABELS[p.program_type] || p.program_type}
                      </span>
                    )}
                    {p.year && (
                      <span className="px-2 py-1 text-xs bg-gray-50 text-gray-600 rounded">{p.year}</span>
                    )}
                  </div>
                  <div className="flex items-center justify-between pt-3 border-t border-gray-100 text-sm">
                    <div className="flex items-center gap-1 text-gray-700">
                      <Users className="h-4 w-4" />
                      <span className="font-semibold">{p.attendee_count}</span>
                      <span className="text-gray-500">حضور</span>
                    </div>
                    {p.org_count > 0 && (
                      <div className="flex items-center gap-1 text-gray-700">
                        <Building2 className="h-4 w-4" />
                        <span className="font-semibold">{p.org_count}</span>
                        <span className="text-gray-500">جهة</span>
                      </div>
                    )}
                  </div>
                </Link>
              );
            })}
          </div>

          {total > limit && (
            <div className="flex justify-center gap-2 mt-8">
              <button disabled={offset === 0}
                      onClick={() => setOffset(Math.max(0, offset - limit))}
                      className="px-4 py-2 border rounded-lg disabled:opacity-50 hover:bg-gray-50">السابق</button>
              <span className="px-4 py-2 text-sm text-gray-600">
                {offset + 1}–{Math.min(offset + limit, total)} من {total}
              </span>
              <button disabled={offset + limit >= total}
                      onClick={() => setOffset(offset + limit)}
                      className="px-4 py-2 border rounded-lg disabled:opacity-50 hover:bg-gray-50">التالي</button>
            </div>
          )}
        </>
      )}
    </div>
  );
}
