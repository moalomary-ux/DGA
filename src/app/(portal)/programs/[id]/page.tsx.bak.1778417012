'use client';

import { useEffect, useState, use } from 'react';
import Link from 'next/link';
import { ArrowRight, Users, Calendar, Building2, Loader2, Star, Mail, Award, MapPin } from 'lucide-react';

interface Program {
  id: number;
  title_ar: string;
  title_en: string | null;
  program_type: string | null;
  category: string | null;
  provider: string | null;
  delivery_mode: string | null;
  start_date: string | null;
  end_date: string | null;
  duration_hours: number | null;
  capacity: number | null;
  rating: number | null;
  status: string | null;
  metadata: Record<string, unknown> | null;
}
interface Attendee {
  id: number;
  full_name_ar: string;
  primary_email: string | null;
  job_title_ar: string | null;
  organization_ar: string | null;
  organization_id: number | null;
  role_category: string | null;
  region: string | null;
  is_excellent: boolean | null;
  user_rating: number | null;
}
interface OrgBreakdown {
  org_name: string;
  organization_id: number | null;
  count: number;
}

export default function ProgramDetailPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = use(params);
  const [data, setData] = useState<{
    program: Program; attendees: Attendee[]; orgBreakdown: OrgBreakdown[];
    stats: { total_attendees: number; excellent_count: number; orgs_represented: number };
  } | null>(null);
  const [tab, setTab] = useState<'attendees' | 'orgs'>('attendees');
  const [search, setSearch] = useState('');

  useEffect(() => {
    fetch(`/api/programs/${id}`).then(r => r.json()).then(d => { if (d.ok) setData(d); });
  }, [id]);

  if (!data) {
    return <div className="flex justify-center p-12"><Loader2 className="h-8 w-8 animate-spin text-blue-500" /></div>;
  }

  const { program, attendees, orgBreakdown, stats } = data;
  const filtered = search
    ? attendees.filter(a => 
        a.full_name_ar?.toLowerCase().includes(search.toLowerCase()) ||
        a.organization_ar?.toLowerCase().includes(search.toLowerCase()) ||
        a.primary_email?.toLowerCase().includes(search.toLowerCase()))
    : attendees;

  return (
    <div className="p-6 max-w-[1400px] mx-auto" dir="rtl">
      <Link href="/programs" className="inline-flex items-center gap-1 text-sm text-gray-600 hover:text-blue-600 mb-4">
        <ArrowRight className="h-4 w-4" /> رجوع للقائمة
      </Link>

      {/* Header */}
      <div className="bg-gradient-to-l from-purple-50 to-white rounded-xl border border-gray-200 p-6 mb-6">
        <h1 className="text-3xl font-bold text-gray-900">{program.title_ar}</h1>
        {program.title_en && <p className="text-lg text-gray-500 mt-1">{program.title_en}</p>}
        
        <div className="flex flex-wrap gap-2 mt-3">
          {program.category && <span className="px-3 py-1 text-sm bg-purple-100 text-purple-700 rounded-full">{program.category}</span>}
          {program.program_type && <span className="px-3 py-1 text-sm bg-blue-100 text-blue-700 rounded-full">{program.program_type}</span>}
          {program.delivery_mode && <span className="px-3 py-1 text-sm bg-emerald-100 text-emerald-700 rounded-full">{program.delivery_mode}</span>}
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5 text-sm">
          {program.provider && (
            <div className="flex items-start gap-2">
              <Building2 className="h-4 w-4 text-gray-400 mt-0.5" />
              <div><div className="text-xs text-gray-500">مزود</div><div className="text-gray-900">{program.provider}</div></div>
            </div>
          )}
          {program.start_date && (
            <div className="flex items-start gap-2">
              <Calendar className="h-4 w-4 text-gray-400 mt-0.5" />
              <div><div className="text-xs text-gray-500">التاريخ</div><div className="text-gray-900">{program.start_date.slice(0,10)}</div></div>
            </div>
          )}
          {program.duration_hours && (
            <div className="flex items-start gap-2">
              <div className="h-4 w-4 text-gray-400 mt-0.5">⏱</div>
              <div><div className="text-xs text-gray-500">المدة</div><div className="text-gray-900">{Number(program.duration_hours).toFixed(0)} ساعة</div></div>
            </div>
          )}
          {program.capacity && (
            <div className="flex items-start gap-2">
              <Users className="h-4 w-4 text-gray-400 mt-0.5" />
              <div><div className="text-xs text-gray-500">السعة</div><div className="text-gray-900">{program.capacity}</div></div>
            </div>
          )}
        </div>

        <div className="grid grid-cols-3 gap-4 mt-5">
          <div className="bg-white rounded-lg border p-3">
            <div className="text-2xl font-bold text-gray-900">{stats.total_attendees}</div>
            <div className="text-xs text-gray-500">إجمالي الحضور</div>
          </div>
          <div className="bg-white rounded-lg border p-3">
            <div className="text-2xl font-bold text-amber-600">{stats.excellent_count}</div>
            <div className="text-xs text-gray-500">متميزون</div>
          </div>
          <div className="bg-white rounded-lg border p-3">
            <div className="text-2xl font-bold text-blue-600">{stats.orgs_represented}</div>
            <div className="text-xs text-gray-500">جهات ممثَّلة</div>
          </div>
        </div>
      </div>

      {/* Tabs */}
      <div className="border-b border-gray-200 mb-4 flex gap-1">
        <button onClick={() => setTab('attendees')}
                className={`px-4 py-2 text-sm font-medium border-b-2 -mb-px ${tab==='attendees'?'border-blue-500 text-blue-600':'border-transparent text-gray-600'}`}>
          الحضور ({stats.total_attendees})
        </button>
        <button onClick={() => setTab('orgs')}
                className={`px-4 py-2 text-sm font-medium border-b-2 -mb-px ${tab==='orgs'?'border-blue-500 text-blue-600':'border-transparent text-gray-600'}`}>
          توزيع الجهات ({stats.orgs_represented})
        </button>
      </div>

      {tab === 'attendees' && (
        <div>
          <input type="text" placeholder="ابحث بالاسم/الإيميل/الجهة..."
                 value={search} onChange={e => setSearch(e.target.value)}
                 className="w-full mb-4 px-4 py-2 border rounded-lg" />
          <div className="bg-white border rounded-xl overflow-hidden">
            <table className="w-full text-sm">
              <thead className="bg-gray-50 text-gray-600">
                <tr>
                  <th className="px-4 py-3 text-right">الاسم</th>
                  <th className="px-4 py-3 text-right">الجهة</th>
                  <th className="px-4 py-3 text-right">المسمى</th>
                  <th className="px-4 py-3 text-right">المنطقة</th>
                  <th className="px-4 py-3 text-center">متميّز</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-100">
                {filtered.map(a => (
                  <tr key={a.id} className="hover:bg-gray-50">
                    <td className="px-4 py-3">
                      <div className="font-medium text-gray-900">{a.full_name_ar}</div>
                      {a.primary_email && (
                        <a href={`mailto:${a.primary_email}`} className="text-xs text-blue-600 hover:underline">{a.primary_email}</a>
                      )}
                    </td>
                    <td className="px-4 py-3">
                      {a.organization_id ? (
                        <Link href={`/orgs/${a.organization_id}`} className="text-blue-600 hover:underline">{a.organization_ar}</Link>
                      ) : (a.organization_ar || '—')}
                    </td>
                    <td className="px-4 py-3 text-gray-600">{a.job_title_ar || '—'}</td>
                    <td className="px-4 py-3 text-gray-600">{a.region || '—'}</td>
                    <td className="px-4 py-3 text-center">
                      {a.is_excellent ? <Award className="h-4 w-4 text-amber-500 inline" /> : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {tab === 'orgs' && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {orgBreakdown.map((o, i) => (
            <Link key={i} href={o.organization_id ? `/orgs/${o.organization_id}` : '#'}
                  className="bg-white border rounded-lg p-4 hover:border-blue-300 transition flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="p-2 bg-blue-50 rounded-lg"><Building2 className="h-5 w-5 text-blue-600" /></div>
                <div className="font-medium text-gray-900">{o.org_name}</div>
              </div>
              <div className="text-2xl font-bold text-blue-600">{o.count}</div>
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}
