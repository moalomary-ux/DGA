'use client';
import { useState, useEffect, useRef } from 'react';

const STORAGE_KEY = 'qudratok-personal-widgets-v2';

type Widget = { id: string; colSpan: number; rowSpan: number; order: number };

const DEFAULT_WIDGETS: Widget[] = [
  { id: 'greeting', colSpan: 12, rowSpan: 3, order: 1 },
  { id: 'stats',    colSpan: 12, rowSpan: 2, order: 2 },
  { id: 'info',     colSpan: 12, rowSpan: 3, order: 3 },
  { id: 'aichat',   colSpan: 8,  rowSpan: 7, order: 4 },
  { id: 'tasks',    colSpan: 4,  rowSpan: 7, order: 5 },
  { id: 'programs', colSpan: 8,  rowSpan: 5, order: 6 },
  { id: 'upcoming', colSpan: 4,  rowSpan: 5, order: 7 },
];

const TITLES: Record<string, string> = {
  greeting: 'ترحيب', stats: 'إحصائيات', info: 'معلومات اليوم',
  aichat: 'المساعد الذكي', tasks: 'مهامي', programs: 'برامجي', upcoming: 'القادم',
};
const ACCENTS: Record<string, string> = {
  greeting: '#7C3AED', stats: '#06B6D4', info: '#F59E0B',
  aichat: '#00D1FF', tasks: '#EF4444', programs: '#10B981', upcoming: '#8B5CF6',
};

type DataShape = {
  user: { name: string; email?: string };
  stats: { messages?: number; programs?: number; tasks?: number; nominations?: number };
  myTasks: Array<{ id: number | string; title: string; program?: string }>;
  upcoming: Array<{ id: number | string; title_ar?: string; title?: string; start_date?: string }>;
  myPrograms: Array<{ id: number | string; title_ar?: string; title?: string; progress?: number }>;
  weather?: { temp?: number; desc?: string };
  prayer?: { next?: string; time?: string };
  date?: { hijri?: string; gregorian?: string };
  news?: Array<{ title: string; source?: string }>;
};

const DEFAULT_DATA: DataShape = {
  user: { name: 'محمد' },
  stats: { messages: 0, programs: 0, tasks: 0, nominations: 0 },
  myTasks: [], upcoming: [], myPrograms: [],
};

export default function PersonalPage() {
  const [widgets, setWidgets] = useState<Widget[]>(DEFAULT_WIDGETS);
  const [editMode, setEditMode] = useState(false);
  const [data, setData] = useState<DataShape>(DEFAULT_DATA);
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) setWidgets(parsed);
      }
    } catch {}
    fetch('/api/home/data').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, ...d })); }).catch(() => {});
    fetch('/api/home/weather').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, weather: d })); }).catch(() => {});
    fetch('/api/home/prayer').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, prayer: d })); }).catch(() => {});
    fetch('/api/home/news').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, news: d.items || [] })); }).catch(() => {});
  }, []);

  const save = (next: Widget[]) => {
    setWidgets(next);
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(next)); } catch {}
  };

  const updateW = (id: string, change: Partial<Widget>) => {
    save(widgets.map((w) => (w.id === id ? { ...w, ...change } : w)));
  };

  const moveOrder = (id: string, dir: 'up' | 'down') => {
    const sorted = [...widgets].sort((a, b) => a.order - b.order);
    const idx = sorted.findIndex((w) => w.id === id);
    if (idx === -1) return;
    const target = dir === 'up' ? idx - 1 : idx + 1;
    if (target < 0 || target >= sorted.length) return;
    const a = sorted[idx], b = sorted[target];
    const tmpOrder = a.order; a.order = b.order; b.order = tmpOrder;
    save(sorted);
  };

  const reset = () => {
    if (typeof window !== 'undefined' && window.confirm('استعادة التخطيط الافتراضي؟')) save(DEFAULT_WIDGETS);
  };

  const pageStyle: React.CSSProperties = { padding: '16px 24px 80px', background: 'var(--bg)', minHeight: '100vh' };
  const topBarStyle: React.CSSProperties = { display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, gap: 12 };

  const editBtnStyle: React.CSSProperties = {
    padding: '8px 16px',
    background: editMode ? 'linear-gradient(135deg, #10B981, #059669)' : 'var(--surface)',
    color: editMode ? '#fff' : 'var(--text)',
    border: `1px solid ${editMode ? '#059669' : 'color-mix(in srgb, var(--text) 15%, transparent)'}`,
    borderRadius: 10, fontSize: 13, fontWeight: 600, cursor: 'pointer',
  };

  const resetBtnStyle: React.CSSProperties = {
    padding: '8px 16px', background: 'var(--surface)', color: 'var(--text)',
    border: '1px solid color-mix(in srgb, var(--text) 15%, transparent)',
    borderRadius: 10, fontSize: 13, cursor: 'pointer',
  };

  const hintStyle: React.CSSProperties = {
    padding: '10px 14px',
    background: 'color-mix(in srgb, #00D1FF 8%, transparent)',
    border: '1px dashed color-mix(in srgb, #00D1FF 40%, transparent)',
    borderRadius: 10, color: 'var(--text)', fontSize: 12, marginBottom: 12,
  };

  const gridStyle: React.CSSProperties = {
    display: 'grid',
    gridTemplateColumns: 'repeat(12, 1fr)',
    gridAutoRows: '60px',
    gap: 12,
  };

  if (!mounted) return <div style={pageStyle}>جاري التحميل...</div>;

  const sortedWidgets = [...widgets].sort((a, b) => a.order - b.order);

  return (
    <div style={pageStyle}>
      <div style={topBarStyle}>
        <div style={{ color: 'var(--text)', fontSize: 14, opacity: 0.7 }}>أهلاً {data.user?.name || ''}</div>
        <div style={{ display: 'flex', gap: 8 }}>
          {editMode ? <button onClick={reset} style={resetBtnStyle}>استعادة الافتراضي</button> : null}
          <button onClick={() => setEditMode(!editMode)} style={editBtnStyle}>{editMode ? 'حفظ ✓' : 'تعديل ✎'}</button>
        </div>
      </div>

      {editMode ? <div style={hintStyle}>استخدم أزرار التحكم في كل widget: ⇔ عرض، ⇕ طول، ↑↓ ترتيب. كل تعديل يحفظ تلقائياً.</div> : null}

      <div style={gridStyle}>
        {sortedWidgets.map((w) => (
          <div key={w.id} style={{ gridColumn: `span ${w.colSpan}`, gridRow: `span ${w.rowSpan}` }}>
            <WidgetWrap widget={w} editMode={editMode} onUpdate={updateW} onMove={moveOrder} data={data} />
          </div>
        ))}
      </div>
    </div>
  );
}

function WidgetWrap({ widget, editMode, onUpdate, onMove, data }: { widget: Widget; editMode: boolean; onUpdate: any; onMove: any; data: DataShape }) {
  const W = widget;
  const accent = ACCENTS[W.id] || '#06B6D4';

  const wrapStyle: React.CSSProperties = {
    background: 'var(--surface)',
    border: editMode ? `2px dashed ${accent}` : '1px solid color-mix(in srgb, var(--text) 8%, transparent)',
    borderRadius: 14,
    height: '100%',
    display: 'flex', flexDirection: 'column', overflow: 'hidden',
    boxShadow: 'var(--shadow-sm)',
  };

  const headerStyle: React.CSSProperties = {
    padding: '8px 14px',
    display: 'flex', alignItems: 'center', justifyContent: 'space-between',
    background: editMode ? `color-mix(in srgb, ${accent} 8%, var(--surface))` : 'transparent',
    borderBottom: editMode ? `1px solid color-mix(in srgb, ${accent} 25%, transparent)` : 'none',
    flexShrink: 0, gap: 8, flexWrap: 'wrap',
  };

  const ctrlStyle: React.CSSProperties = {
    width: 26, height: 22, padding: 0,
    background: 'color-mix(in srgb, var(--text) 8%, transparent)',
    border: '1px solid color-mix(in srgb, var(--text) 15%, transparent)',
    borderRadius: 6, color: 'var(--text)', fontSize: 11, cursor: 'pointer', fontWeight: 600,
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
  };

  const contentStyle: React.CSSProperties = {
    flex: 1, overflow: 'auto', padding: W.id === 'aichat' ? 0 : 12,
  };

  return (
    <div style={wrapStyle}>
      <div style={headerStyle}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 6, color: 'var(--text)', fontSize: 12, fontWeight: 600 }}>
          <span style={{ width: 6, height: 6, borderRadius: '50%', background: accent }} />
          {TITLES[W.id]}
          {editMode ? <span style={{ marginInlineStart: 8, color: 'var(--text)', opacity: 0.5, fontSize: 10 }}>{W.colSpan}×{W.rowSpan}</span> : null}
        </div>
        {editMode ? (
          <div style={{ display: 'flex', gap: 3 }}>
            <button onClick={() => onUpdate(W.id, { colSpan: Math.max(2, W.colSpan - 2) })} title="تقليل العرض" style={ctrlStyle}>−⇔</button>
            <button onClick={() => onUpdate(W.id, { colSpan: Math.min(12, W.colSpan + 2) })} title="زيادة العرض" style={ctrlStyle}>+⇔</button>
            <button onClick={() => onUpdate(W.id, { rowSpan: Math.max(2, W.rowSpan - 1) })} title="تقليل الطول" style={ctrlStyle}>−⇕</button>
            <button onClick={() => onUpdate(W.id, { rowSpan: Math.min(15, W.rowSpan + 1) })} title="زيادة الطول" style={ctrlStyle}>+⇕</button>
            <button onClick={() => onMove(W.id, 'up')} title="فوق" style={ctrlStyle}>↑</button>
            <button onClick={() => onMove(W.id, 'down')} title="تحت" style={ctrlStyle}>↓</button>
          </div>
        ) : null}
      </div>
      <div style={contentStyle}>{renderWidget(W.id, data)}</div>
    </div>
  );
}

function renderWidget(id: string, data: DataShape) {
  if (id === 'greeting') return <GreetingW data={data} />;
  if (id === 'stats') return <StatsW data={data} />;
  if (id === 'info') return <InfoW data={data} />;
  if (id === 'aichat') return <MiniChat userName={(data.user?.name || '').split(' ')[0]} />;
  if (id === 'tasks') return <TasksW data={data} />;
  if (id === 'programs') return <ProgramsW data={data} />;
  if (id === 'upcoming') return <UpcomingW data={data} />;
  return null;
}

function GreetingW({ data }: { data: DataShape }) {
  return (
    <div style={{ background: 'linear-gradient(135deg, #06B6D4, #7C3AED)', color: '#fff', borderRadius: 12, padding: 20, height: '100%', display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
      <div style={{ fontSize: 20, fontWeight: 700, marginBottom: 6 }}>طاب يومك، {data.user?.name || 'محمد'}</div>
      <div style={{ fontSize: 13, opacity: 0.92 }}>لديك {data.stats?.tasks || 0} مهام مفتوحة و{data.stats?.programs || 0} برامج جارية.</div>
    </div>
  );
}

function StatsW({ data }: { data: DataShape }) {
  const cards = [
    { label: 'رسائل', value: data.stats?.messages || 0, color: '#06B6D4' },
    { label: 'ترشيحات', value: data.stats?.nominations || 0, color: '#F59E0B' },
    { label: 'مهام', value: data.stats?.tasks || 0, color: '#EF4444' },
    { label: 'برامج', value: data.stats?.programs || 0, color: '#10B981' },
  ];
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 10, height: '100%' }}>
      {cards.map((c) => (
        <div key={c.label} style={{ background: 'color-mix(in srgb, var(--bg) 50%, transparent)', border: `1px solid color-mix(in srgb, ${c.color} 25%, transparent)`, borderRadius: 10, padding: 12, display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'center' }}>
          <div style={{ fontSize: 22, fontWeight: 800, color: c.color }}>{c.value}</div>
          <div style={{ fontSize: 11, color: 'var(--text)', opacity: 0.7, marginTop: 4 }}>{c.label}</div>
        </div>
      ))}
    </div>
  );
}

function InfoW({ data }: { data: DataShape }) {
  const items = [
    { label: 'الطقس', value: data.weather?.temp ? `${data.weather.temp}°` : '—', sub: data.weather?.desc || '' },
    { label: 'الصلاة', value: data.prayer?.next || '—', sub: data.prayer?.time || '' },
    { label: 'التاريخ', value: data.date?.gregorian || '—', sub: data.date?.hijri || '' },
    { label: 'الأخبار', value: (data.news?.[0]?.title || '—').slice(0, 28), sub: data.news?.[0]?.source || '' },
  ];
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 10, height: '100%' }}>
      {items.map((i) => (
        <div key={i.label} style={{ background: 'color-mix(in srgb, var(--bg) 40%, transparent)', borderRadius: 10, padding: 12, display: 'flex', flexDirection: 'column' }}>
          <div style={{ fontSize: 10, color: 'var(--text)', opacity: 0.55, marginBottom: 4 }}>{i.label}</div>
          <div style={{ fontSize: 14, fontWeight: 700, color: 'var(--text)' }}>{i.value}</div>
          <div style={{ fontSize: 11, color: 'var(--text)', opacity: 0.6, marginTop: 'auto' }}>{i.sub}</div>
        </div>
      ))}
    </div>
  );
}

function TasksW({ data }: { data: DataShape }) {
  const tasks = data.myTasks || [];
  if (tasks.length === 0) return <div style={{ textAlign: 'center', color: 'var(--text)', opacity: 0.5, fontSize: 13, padding: 20 }}>لا توجد مهام</div>;
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
      {tasks.slice(0, 10).map((t) => (
        <div key={t.id} style={{ background: 'color-mix(in srgb, var(--bg) 40%, transparent)', borderRadius: 8, padding: '8px 12px' }}>
          <div style={{ fontSize: 13, color: 'var(--text)', fontWeight: 500 }}>{t.title}</div>
          {t.program ? <div style={{ fontSize: 11, opacity: 0.6, color: 'var(--text)' }}>{t.program}</div> : null}
        </div>
      ))}
    </div>
  );
}

function ProgramsW({ data }: { data: DataShape }) {
  const progs = data.myPrograms || [];
  if (progs.length === 0) return <div style={{ textAlign: 'center', color: 'var(--text)', opacity: 0.5, fontSize: 13, padding: 20 }}>لا برامج مسندة</div>;
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
      {progs.slice(0, 8).map((p) => {
        const pct = p.progress ?? 0;
        return (
          <div key={p.id} style={{ background: 'color-mix(in srgb, var(--bg) 40%, transparent)', borderRadius: 8, padding: '10px 12px' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
              <div style={{ fontSize: 13, color: 'var(--text)', fontWeight: 600 }}>{p.title_ar || p.title}</div>
              <div style={{ fontSize: 11, opacity: 0.6, color: 'var(--text)' }}>{pct}%</div>
            </div>
            <div style={{ background: 'color-mix(in srgb, var(--text) 10%, transparent)', height: 4, borderRadius: 4, overflow: 'hidden' }}>
              <div style={{ background: 'linear-gradient(90deg, #10B981, #06B6D4)', height: '100%', width: `${pct}%` }} />
            </div>
          </div>
        );
      })}
    </div>
  );
}

function UpcomingW({ data }: { data: DataShape }) {
  const items = data.upcoming || [];
  if (items.length === 0) return <div style={{ textAlign: 'center', color: 'var(--text)', opacity: 0.5, fontSize: 13, padding: 20 }}>لا برامج قادمة</div>;
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
      {items.slice(0, 6).map((it) => (
        <div key={it.id} style={{ background: 'color-mix(in srgb, var(--bg) 40%, transparent)', borderRadius: 8, padding: '8px 12px' }}>
          <div style={{ fontSize: 13, color: 'var(--text)', fontWeight: 500 }}>{it.title_ar || it.title}</div>
          <div style={{ fontSize: 11, opacity: 0.6, color: 'var(--text)' }}>{it.start_date || ''}</div>
        </div>
      ))}
    </div>
  );
}

function MiniChat({ userName }: { userName: string }) {
  const [messages, setMessages] = useState<{ role: 'user' | 'assistant'; content: string }[]>([]);
  const [input, setInput] = useState('');
  const [streaming, setStreaming] = useState(false);
  const [convId, setConvId] = useState<number | null>(null);
  const [model, setModel] = useState('auto');
  const [modelOpen, setModelOpen] = useState(false);
  const bodyRef = useRef<HTMLDivElement>(null);

  const C = {
    bg: '#070B1A',
    bgAccent: '#0B1023',
    bgElevated: '#101935',
    border: 'rgba(0, 209, 255, 0.15)',
    primary: '#00D1FF',
    primaryDark: '#00B8D9',
    text: '#EAF4FF',
    textMuted: '#A9B8D4',
    online: '#00FF88',
  };

  const MODELS = [
    { id: 'auto', label: 'Auto' },
    { id: 'gpt-5', label: 'GPT-5' },
    { id: 'claude', label: 'Claude' },
    { id: 'gemini', label: 'Gemini' },
    { id: 'local', label: 'Local' },
  ];

  useEffect(() => {
    bodyRef.current?.scrollTo({ top: bodyRef.current.scrollHeight, behavior: 'smooth' });
  }, [messages, streaming]);

  const send = async (text?: string) => {
    const msg = (text || input).trim();
    if (!msg || streaming) return;
    setInput('');
    setMessages((m) => [...m, { role: 'user', content: msg }, { role: 'assistant', content: '' }]);
    setStreaming(true);
    try {
      const body: any = { message: msg, model: model === 'auto' ? '__auto__' : model };
      if (convId) body.conversationId = convId;
      const res = await fetch('/api/assistant/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const errText = await res.text().catch(() => '');
        throw new Error('HTTP ' + res.status + (errText ? ': ' + errText.slice(0, 80) : ''));
      }
      if (!res.body) throw new Error('no response');
      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let buf = '';
      let asst = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const events = buf.split('\n\n');
        buf = events.pop() || '';
        for (const ev of events) {
          if (!ev.startsWith('data: ')) continue;
          try {
            const d = JSON.parse(ev.slice(6));
            if (d.type === 'text') {
              asst += d.text;
              setMessages((m) => {
                const copy = [...m];
                copy[copy.length - 1] = { role: 'assistant', content: asst };
                return copy;
              });
            } else if (d.type === 'meta' && d.conversationId) {
              setConvId(d.conversationId);
            }
          } catch {}
        }
      }
    } catch (e: any) {
      setMessages((m) => {
        const copy = [...m];
        copy[copy.length - 1] = { role: 'assistant', content: 'خطأ: ' + (e?.message || '') };
        return copy;
      });
    } finally {
      setStreaming(false);
    }
  };

  const newChat = () => { setMessages([]); setConvId(null); setInput(''); };

  const chips = ['لخص التقرير', 'أنشئ دراسة', 'اقترح أفكار', 'تحليل البيانات'];
  const isDisabled = streaming || !input.trim();
  const modelLabel = MODELS.find((m) => m.id === model)?.label || 'Auto';

  const containerStyle: React.CSSProperties = {
    margin: '0 0 16px 0',
    width: '100%',
    height: 420,
    background: C.bg,
    border: `1px solid ${C.border}`,
    borderRadius: 20,
    boxShadow: '0 0 40px rgba(0, 209, 255, 0.05), 0 12px 32px rgba(0, 0, 0, 0.45)',
    overflow: 'hidden',
    display: 'flex',
    flexDirection: 'column',
    position: 'relative',
  };

  const headerStyle: React.CSSProperties = {
    padding: '12px 16px',
    background: `linear-gradient(180deg, ${C.bgAccent}, ${C.bg})`,
    borderBottom: `1px solid ${C.border}`,
    display: 'flex',
    alignItems: 'center',
    gap: 10,
  };

  const avatarStyle: React.CSSProperties = {
    width: 36, height: 36, borderRadius: '50%',
    background: `radial-gradient(circle at 30% 30%, ${C.primary}, ${C.primaryDark})`,
    boxShadow: '0 0 12px rgba(0, 209, 255, 0.45)',
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    color: '#001122', fontWeight: 800, fontSize: 16, flexShrink: 0,
  };

  const ghostBtn: React.CSSProperties = {
    width: 32, height: 32, borderRadius: 8,
    background: 'transparent',
    border: `1px solid ${C.border}`,
    color: C.textMuted,
    fontSize: 13,
    cursor: 'pointer',
    flexShrink: 0,
  };

  const topGlowStyle: React.CSSProperties = {
    position: 'absolute',
    top: 0, left: '20%', right: '20%',
    height: 1,
    background: `linear-gradient(90deg, transparent, ${C.primary}, transparent)`,
