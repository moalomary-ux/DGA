'use client';
import { useState, useEffect, useRef } from 'react';

const STORAGE_KEY = 'qudratok-personal-widgets-v2';

type Widget = { id: string; colSpan: number; rowSpan: number; order: number };

const DEFAULT_WIDGETS: Widget[] = [
  { id: 'greeting', colSpan: 12, rowSpan: 5, order: 1 },
  { id: 'stats',    colSpan: 12, rowSpan: 2, order: 2 },
  { id: 'news',     colSpan: 12, rowSpan: 3, order: 4 },
  { id: 'aichat',   colSpan: 8,  rowSpan: 7, order: 5 },
  { id: 'tasks',    colSpan: 4,  rowSpan: 7, order: 6 },
  { id: 'programs', colSpan: 8,  rowSpan: 5, order: 7 },
  { id: 'upcoming', colSpan: 4,  rowSpan: 5, order: 8 },
];

const TITLES: Record<string, string> = {
  greeting: 'ترحيب', stats: 'إحصائيات', info: 'معلومات اليوم', news: 'آخر الأخبار التقنية',
  aichat: 'المساعد الذكي', tasks: 'مهامي', programs: 'برامجي', upcoming: 'القادم',
};
const ACCENTS: Record<string, string> = {
  greeting: '#7C3AED', stats: '#06B6D4', info: '#F59E0B', news: '#F43F5E',
  aichat: '#00D1FF', tasks: '#EF4444', programs: '#10B981', upcoming: '#7C3AED',
};

type Prayer = { name: string; time: string; en?: string };
type DataShape = {
  user: { name: string; email?: string; initials?: string };
  stats: { messages?: number; programs?: number; tasks?: number; nominations?: number };
  myTasks: Array<{ id: number | string; title: string; program?: string }>;
  upcoming: Array<{ id: number | string; title_ar?: string; title?: string; start_date?: string }>;
  myPrograms: Array<{ id: number | string; title_ar?: string; title?: string; progress?: number; status?: string; code?: string }>;
  weather?: { ok?: boolean; city?: string; current?: { temp?: number; desc?: string; is_day?: boolean; code?: number }; forecast?: any[] };
  prayer?: { ok?: boolean; city?: string; hijri?: { day?: string; month?: { ar?: string; en?: string }; year?: string }; gregorian?: { day?: string; month?: { en?: string; ar?: string }; year?: string; weekday?: { en?: string } }; prayers?: Prayer[] };
  news?: Array<{ title: string; link?: string; source?: string; pubDate?: string; category?: string; label?: string; color?: string }>;
};

const DEFAULT_DATA: DataShape = {
  user: { name: 'محمد' },
  stats: { messages: 0, programs: 0, tasks: 0, nominations: 0 },
  myTasks: [], upcoming: [], myPrograms: [],
};

export default function PersonalPage() {
  const [widgets, setWidgets] = useState<Widget[]>(DEFAULT_WIDGETS);
  const [editMode, setEditMode] = useState(false);
  const [data, setData] = useState<DataShape>(DEFAULT_DATA);
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) {
          const savedIds = new Set(parsed.map((w: Widget) => w.id));
          const missing = DEFAULT_WIDGETS.filter((w) => !savedIds.has(w.id));
          if (missing.length > 0) {
            const maxOrder = Math.max(...parsed.map((w: Widget) => w.order), 0);
            const extras = missing.map((w: Widget, i: number) => ({ ...w, order: maxOrder + 1 + i }));
            setWidgets([...parsed, ...extras]);
          } else {
            setWidgets(parsed);
          }
        }
      }
    } catch {}
    fetch('/api/home/data').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, ...d })); }).catch(() => {});
    fetch('/api/home/weather').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, weather: d })); }).catch(() => {});
    fetch('/api/home/prayer').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, prayer: d })); }).catch(() => {});
    fetch('/api/home/news').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, news: d.items || [] })); }).catch(() => {});
    fetch('/api/home/wisdom').then((r) => r.json()).then((d) => { if (d && d.ok) setData((p) => ({ ...p, wisdom: d.wisdom })); }).catch(() => {});
    fetch('/api/tasks').then((r) => r.json()).then((d) => {
      if (d && d.ok) {
        const allTasks = (d.tasks || []).map((t: any) => ({
          id: t.assignment_id, title: t.title_ar, program: t.role_label, program_id: t.program_id,
        }));
        const now = new Date();
        const week = new Date(now.getTime() + 7 * 86400000);
        const upcomingTasks = (d.tasks || []).filter((t: any) => {
          if (!t.end_date || t.status === 'closed') return false;
          const due = new Date(t.end_date);
          return due >= now && due <= week;
        }).map((t: any) => ({
          id: t.program_id, title_ar: t.title_ar, start_date: t.end_date,
        }));
        setData((p) => ({
          ...p,
          myTasks: allTasks,
          upcoming: upcomingTasks,
          stats: { ...(p.stats || {}), tasks: d.stats?.active || 0 },
        }));
      }
    }).catch(() => {});
  }, []);

  const save = (next: Widget[]) => {
    setWidgets(next);
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(next)); } catch {}
  };

  const updateW = (id: string, change: Partial<Widget>) => {
    save(widgets.map((w) => (w.id === id ? { ...w, ...change } : w)));
  };

  const moveOrder = (id: string, dir: 'up' | 'down') => {
    const sorted = [...widgets].sort((a, b) => a.order - b.order);
    const idx = sorted.findIndex((w) => w.id === id);
    if (idx === -1) return;
    const target = dir === 'up' ? idx - 1 : idx + 1;
    if (target < 0 || target >= sorted.length) return;
    const a = sorted[idx], b = sorted[target];
    const tmpOrder = a.order; a.order = b.order; b.order = tmpOrder;
    save(sorted);
  };

  const reset = () => {
    if (typeof window !== 'undefined' && window.confirm('استعادة التخطيط الافتراضي؟')) save(DEFAULT_WIDGETS);
  };

  const pageStyle: React.CSSProperties = { padding: '16px 24px 80px', background: 'var(--bg)', minHeight: '100vh' };
  const topBarStyle: React.CSSProperties = { display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, gap: 12 };

  const editBtnStyle: React.CSSProperties = {
    padding: '8px 16px',
    background: editMode ? 'linear-gradient(135deg, #10B981, #059669)' : 'var(--surface)',
    color: editMode ? '#fff' : 'var(--text)',
    border: `1px solid ${editMode ? '#059669' : 'color-mix(in srgb, var(--text) 15%, transparent)'}`,
    borderRadius: 10, fontSize: 13, fontWeight: 600, cursor: 'pointer',
  };

  const resetBtnStyle: React.CSSProperties = {
    padding: '8px 16px', background: 'var(--surface)', color: 'var(--text)',
    border: '1px solid color-mix(in srgb, var(--text) 15%, transparent)',
    borderRadius: 10, fontSize: 13, cursor: 'pointer',
  };

  const hintStyle: React.CSSProperties = {
    padding: '10px 14px',
    background: 'color-mix(in srgb, #00D1FF 8%, transparent)',
    border: '1px dashed color-mix(in srgb, #00D1FF 40%, transparent)',
    borderRadius: 10, color: 'var(--text)', fontSize: 12, marginBottom: 12,
  };

  const gridStyle: React.CSSProperties = {
    display: 'grid',
    gridTemplateColumns: 'repeat(12, 1fr)',
    gridAutoRows: '60px',
    gap: 12,
  };

  if (!mounted) return <div style={pageStyle}>جاري التحميل...</div>;

  const sortedWidgets = [...widgets].sort((a, b) => a.order - b.order);

  return (
    <div style={pageStyle}>
      <div style={topBarStyle}>
        <div style={{ color: 'var(--text)', fontSize: 14, opacity: 0.7 }}>أهلاً {data.user?.name || ''}</div>
        <div style={{ display: 'flex', gap: 8 }}>
          {editMode ? <button onClick={reset} style={resetBtnStyle}>استعادة الافتراضي</button> : null}
          <button onClick={() => setEditMode(!editMode)} style={editBtnStyle}>{editMode ? 'حفظ ✓' : 'تعديل ✎'}</button>
        </div>
      </div>

      {editMode ? <div style={hintStyle}>استخدم أزرار التحكم في كل widget: ⇔ عرض، ⇕ طول، ↑↓ ترتيب. كل تعديل يحفظ تلقائياً.</div> : null}

      <div style={gridStyle}>
        {sortedWidgets.map((w) => (
          <div key={w.id} style={{ gridColumn: `span ${w.colSpan}`, gridRow: `span ${w.rowSpan}` }}>
            <WidgetWrap widget={w} editMode={editMode} onUpdate={updateW} onMove={moveOrder} data={data} />
          </div>
        ))}
      </div>
    </div>
  );
}

function WidgetWrap({ widget, editMode, onUpdate, onMove, data }: { widget: Widget; editMode: boolean; onUpdate: any; onMove: any; data: DataShape }) {
  const W = widget;
  const accent = ACCENTS[W.id] || '#06B6D4';

  const wrapStyle: React.CSSProperties = {
    background: 'var(--surface)',
    border: editMode ? `2px dashed ${accent}` : '1px solid color-mix(in srgb, var(--text) 8%, transparent)',
    borderRadius: 14,
    height: '100%',
    display: 'flex', flexDirection: 'column', overflow: 'hidden',
    boxShadow: 'var(--shadow-sm)',
  };

  const headerStyle: React.CSSProperties = {
    padding: '8px 14px',
    display: 'flex', alignItems: 'center', justifyContent: 'space-between',
    background: editMode ? `color-mix(in srgb, ${accent} 8%, var(--surface))` : 'transparent',
    borderBottom: editMode ? `1px solid color-mix(in srgb, ${accent} 25%, transparent)` : 'none',
    flexShrink: 0, gap: 8, flexWrap: 'wrap',
  };

  const ctrlStyle: React.CSSProperties = {
    width: 26, height: 22, padding: 0,
    background: 'color-mix(in srgb, var(--text) 8%, transparent)',
    border: '1px solid color-mix(in srgb, var(--text) 15%, transparent)',
    borderRadius: 6, color: 'var(--text)', fontSize: 11, cursor: 'pointer', fontWeight: 600,
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
  };

  const contentStyle: React.CSSProperties = {
    flex: 1, overflow: 'auto', padding: W.id === 'aichat' ? 0 : 12,
  };

  return (
    <div style={wrapStyle}>
      <div style={headerStyle}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 6, color: 'var(--text)', fontSize: 12, fontWeight: 600 }}>
          <span style={{ width: 6, height: 6, borderRadius: '50%', background: accent }} />
          {TITLES[W.id]}
          {editMode ? <span style={{ marginInlineStart: 8, color: 'var(--text)', opacity: 0.5, fontSize: 10 }}>{W.colSpan}×{W.rowSpan}</span> : null}
        </div>
        {editMode ? (
          <div style={{ display: 'flex', gap: 3 }}>
            <button onClick={() => onUpdate(W.id, { colSpan: Math.max(2, W.colSpan - 2) })} title="تقليل العرض" style={ctrlStyle}>−⇔</button>
            <button onClick={() => onUpdate(W.id, { colSpan: Math.min(12, W.colSpan + 2) })} title="زيادة العرض" style={ctrlStyle}>+⇔</button>
            <button onClick={() => onUpdate(W.id, { rowSpan: Math.max(2, W.rowSpan - 1) })} title="تقليل الطول" style={ctrlStyle}>−⇕</button>
            <button onClick={() => onUpdate(W.id, { rowSpan: Math.min(15, W.rowSpan + 1) })} title="زيادة الطول" style={ctrlStyle}>+⇕</button>
            <button onClick={() => onMove(W.id, 'up')} title="فوق" style={ctrlStyle}>↑</button>
            <button onClick={() => onMove(W.id, 'down')} title="تحت" style={ctrlStyle}>↓</button>
          </div>
        ) : null}
      </div>
      <div style={contentStyle}>{renderWidget(W.id, data)}</div>
    </div>
  );
}

function renderWidget(id: string, data: DataShape) {
  if (id === 'greeting') return <GreetingW data={data} />;
  if (id === 'stats') return <StatsW data={data} />;
  if (id === 'info') return <InfoW data={data} />;
  if (id === 'news') return <NewsW data={data} />;
  if (id === 'aichat') return <MiniChat userName={(data.user?.name || '').split(' ')[0]} />;
  if (id === 'tasks') return <TasksW data={data} />;
  if (id === 'programs') return <ProgramsW data={data} />;
  if (id === 'upcoming') return <UpcomingW data={data} />;
  return null;
}

function GreetingW({ data, time }: any) {
  const safeTime: Date = (time instanceof Date && !isNaN(time.getTime())) ? time : new Date();
  const hour = safeTime.getHours();
  const greeting = hour < 12 ? 'صباح الخير' : hour < 17 ? 'طاب يومك' : 'مساء الخير';
  const fullDisplay = data?.user?.full_name || 'محمد العُمري';

  const safe = (locale: string, opts: any) => {
    try { return new Intl.DateTimeFormat(locale, opts).format(safeTime); } catch (e) { return ''; }
  };
  const timeStr = safe('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
  const dayAr   = safe('ar-SA', { weekday: 'long' });
  const dayEn   = safe('en-US', { weekday: 'long' });
  const dateAr  = safe('ar-SA', { day: 'numeric', month: 'long', year: 'numeric', numberingSystem: 'latn' });
  const dateEn  = safe('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
  let hijri = '';
  try { hijri = new Intl.DateTimeFormat('ar-SA', { calendar: 'islamic' as any, day: 'numeric', month: 'long', year: 'numeric', numberingSystem: 'latn' }).format(safeTime); } catch (e) {}

  const wisdom = data?.wisdom as { ar: string; en: string } | undefined;

  // === Inline info card data (matches actual API shapes) ===
  const w: any = data?.weather || {};
  const pr: any = data?.prayer || {};

  // Weather: { ok, city, current: { temp, desc, code, is_day }, forecast }
  const tempRaw = w.current?.temp ?? w.temperature ?? w.temp;
  const weatherTempStr = (tempRaw !== undefined && tempRaw !== null && !isNaN(Number(tempRaw)))
    ? `${Math.round(Number(tempRaw))}°` : '--°';
  const weatherCond = w.current?.desc || w.condition_ar || w.condition || '';
  const weatherCity = w.city || w.location_ar || w.location || 'الرياض';

  // Prayer: { ok, prayers: [{ name, time, en }] } — compute next from current time
  const prayerArr: any[] = Array.isArray(pr.prayers) ? pr.prayers : [];
  const nowMins = safeTime.getHours() * 60 + safeTime.getMinutes();
  const eligible = prayerArr.filter((p: any) => p && p.en !== 'Sunrise');
  const nextPrayer = eligible.find((p: any) => {
    if (!p.time) return false;
    const parts = String(p.time).split(':');
    const mins = (Number(parts[0]) || 0) * 60 + (Number(parts[1]) || 0);
    return mins > nowMins;
  }) || eligible[0] || null;
  const prayerName = nextPrayer?.name || '—';
  const prayerTime = nextPrayer?.time || '';
  
  // Hijri split: "25 ذو القعدة 1447 هـ" → day="25", rest="ذو القعدة"
  const hijriMatch = hijri.match(/^(\S+)\s+(.+?)(?:\s+\d+\s*هـ?)?$/);
  const hijriDay = hijriMatch ? hijriMatch[1] : (hijri.split(' ')[0] || '');
  const hijriMonth = hijriMatch ? hijriMatch[2].replace(/\s+\d+\s*هـ?$/, '') : '';

  return (
    <div style={{
      background: 'linear-gradient(135deg, #0E7490 0%, #1E40AF 50%, #5B21B6 100%)',
      color: '#fff', borderRadius: 14, padding: '20px 24px',
      height: '100%', position: 'relative', overflow: 'hidden',
      display: 'flex', flexDirection: 'column', gap: 14,
    }}>
      <div style={{ position: 'absolute', top: -60, insetInlineEnd: -60, width: 240, height: 240, borderRadius: '50%', background: 'rgba(255,255,255,0.08)', pointerEvents: 'none' }} />
      <div style={{ position: 'absolute', bottom: -100, insetInlineStart: -40, width: 220, height: 220, borderRadius: '50%', background: 'rgba(255,255,255,0.05)', pointerEvents: 'none' }} />

      {/* TOP — greeting + name + wisdom | clock + dates */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 20, position: 'relative', flexWrap: 'wrap' }}>
        <div style={{ flex: 1, minWidth: 260 }}>
          <div style={{ fontSize: 12, opacity: 0.88, marginBottom: 3, fontWeight: 500 }}>{greeting}</div>
          <div style={{ display: 'flex', alignItems: 'flex-start', gap: 20, flexWrap: 'wrap', marginBottom: 4 }}>
            <div style={{ fontSize: 36, fontWeight: 800, letterSpacing: -0.9, lineHeight: 1.05, flexShrink: 0 }}>{fullDisplay}</div>
            {wisdom ? (
              <>
                <div style={{ width: 1, alignSelf: 'stretch', background: 'rgba(255,255,255,0.30)', minHeight: 72 }} />
                <div style={{ flex: 1, minWidth: 220, paddingTop: 4 }}>
                  <div style={{ fontSize: 11, opacity: 0.90, fontWeight: 700, letterSpacing: 1.4, marginBottom: 6, color: '#fff' }}>{'\u2728'} حكمة اليوم</div>
                  <div style={{ fontSize: 17, fontWeight: 700, lineHeight: 1.4, color: '#fff' }}>{wisdom.ar}</div>
                  <div style={{ fontSize: 12, opacity: 0.72, fontStyle: 'italic', textAlign: 'right', lineHeight: 1.3, marginTop: 4, unicodeBidi: 'plaintext' }}>{wisdom.en}</div>
                </div>
              </>
            ) : null}
          </div>
        </div>
        <div style={{ textAlign: 'left', direction: 'ltr', minWidth: 200 }}>
          <div style={{
            fontSize: 40, fontWeight: 800, letterSpacing: -1.5,
            lineHeight: 1, marginBottom: 8,
            fontVariantNumeric: 'tabular-nums',
            textShadow: '0 2px 12px rgba(0,0,0,0.2)',
          }}>{timeStr || '--:--'}</div>
          {(dayAr || dayEn) ? (
            <div style={{ fontSize: 12, opacity: 0.94, marginBottom: 4, direction: 'rtl', fontWeight: 600 }}>
              {dayAr ? <span>{dayAr}</span> : null}
              {(dayAr && dayEn) ? ' \u00B7 ' : ''}
              {dayEn ? <span style={{ direction: 'ltr', display: 'inline-block' }}>{dayEn}</span> : null}
            </div>
          ) : null}
          {dateAr ? <div style={{ fontSize: 11, opacity: 0.88, direction: 'rtl', marginBottom: 1, fontWeight: 500 }}>{dateAr}</div> : null}
          {dateEn ? <div style={{ fontSize: 10, opacity: 0.78, marginBottom: 1 }}>{dateEn}</div> : null}
          {hijri ? <div style={{ fontSize: 11, opacity: 0.86, marginTop: 4, direction: 'rtl', fontWeight: 500 }}>{hijri}</div> : null}
        </div>
      </div>

      {/* BOTTOM — 3 inline info cards inside same gradient */}
      <div style={{
        marginTop: 'auto',
        paddingTop: 14,
        borderTop: '1px solid rgba(255,255,255,0.16)',
        display: 'grid',
        gridTemplateColumns: 'repeat(3, 1fr)',
        gap: 12,
        position: 'relative',
      }}>
        <InlineInfo icon={'\u2600\uFE0F'} label={weatherCity} value={weatherTempStr} sub={weatherCond} />
        <InlineInfo icon={'\u2728'} label="الصلاة القادمة" value={prayerName} sub={prayerTime} />
        <InlineInfo icon={'\u25C6'} label="التاريخ الهجري" value={hijriDay} sub={hijriMonth} />
      </div>
    </div>
  );
}

function InlineInfo({ icon, label, value, sub }: any) {
  const [hover, setHover] = useState(false);
  return (
    <div onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)} style={{
      background: hover ? 'rgba(255,255,255,0.22)' : 'rgba(255,255,255,0.10)',
      border: `1px solid rgba(255,255,255,${hover ? 0.40 : 0.20})`,
      backdropFilter: 'blur(12px)',
      borderRadius: 12, padding: '14px 16px',
      transition: 'all 0.22s',
      transform: hover ? 'translateY(-3px)' : 'none',
      boxShadow: hover ? '0 10px 26px rgba(0,0,0,0.22)' : 'none',
      position: 'relative', overflow: 'hidden', cursor: 'default',
    }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12, position: 'relative' }}>
        <span style={{ fontSize: 16, opacity: hover ? 1 : 0.85, transition: 'opacity 0.22s' }}>{icon}</span>
        <span style={{ fontSize: 11, color: '#fff', opacity: 0.85, fontWeight: 700, letterSpacing: 0.4 }}>{label}</span>
      </div>
      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, flexWrap: 'wrap', position: 'relative' }}>
        <span style={{
          fontSize: 26, fontWeight: 800, color: '#fff',
          lineHeight: 1, letterSpacing: -0.6,
          fontVariantNumeric: 'tabular-nums',
          textShadow: hover ? '0 0 16px rgba(255,255,255,0.45)' : 'none',
          transition: 'text-shadow 0.22s',
        }}>{value || '--'}</span>
        {sub ? <span style={{
          fontSize: 22, fontWeight: 600, color: '#fff', opacity: 0.88,
          lineHeight: 1, letterSpacing: -0.3,
        }}>{sub}</span> : null}
      </div>
    </div>
  );
}

function StatsW({ data }: { data: DataShape }) {
  const cards = [
    { label: 'رسائل', value: data.stats?.messages || 0, color: '#06B6D4' },
    { label: 'ترشيحات', value: data.stats?.nominations || 0, color: '#F59E0B' },
    { label: 'مهام', value: data.stats?.tasks || 0, color: '#EF4444' },
    { label: 'برامج', value: data.stats?.programs || 0, color: '#10B981' },
  ];
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 10, height: '100%' }}>
      {cards.map((c) => (
        <div key={c.label} style={{ background: 'color-mix(in srgb, var(--bg) 50%, transparent)', border: `1px solid color-mix(in srgb, ${c.color} 25%, transparent)`, borderRadius: 10, padding: 12, display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'center' }}>
          <div style={{ fontSize: 22, fontWeight: 800, color: c.color }}>{c.value}</div>
          <div style={{ fontSize: 11, color: 'var(--text)', opacity: 0.7, marginTop: 4 }}>{c.label}</div>
        </div>
      ))}
    </div>
  );
}

function getNextPrayer(prayers?: Prayer[]): Prayer | null {
  if (!prayers || prayers.length === 0) return null;
  const now = new Date();
  const nowMin = now.getHours() * 60 + now.getMinutes();
  for (const p of prayers) {
    if (!p.time || !p.time.includes(':')) continue;
    if (p.en === 'Sunrise') continue;
    const [hh, mm] = p.time.split(':').map(Number);
    if ((hh * 60 + mm) > nowMin) return p;
  }
  return prayers.find((p) => p.en !== 'Sunrise') || prayers[0];
}

function hostFromUrl(u?: string): string {
  if (!u) return '';
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; }
}

function InfoCard({ icon, label, value, sub, color, onClick }: any) {
  const [hover, setHover] = useState(false);
  const [pressed, setPressed] = useState(false);
  const clickable = !!onClick;

  const valueStr = String(value || '');
  const valueLen = valueStr.length;
  const valueFontSize = valueLen <= 4 ? 36 : valueLen <= 7 ? 28 : valueLen <= 11 ? 22 : 18;

  return (
    <div
      onClick={onClick}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => { setHover(false); setPressed(false); }}
      onMouseDown={() => setPressed(true)}
      onMouseUp={() => setPressed(false)}
      style={{
        background: pressed
          ? `linear-gradient(135deg, color-mix(in srgb, ${color} 36%, transparent), color-mix(in srgb, ${color} 14%, transparent))`
          : hover
          ? `linear-gradient(135deg, color-mix(in srgb, ${color} 26%, transparent), color-mix(in srgb, ${color} 9%, transparent))`
          : `linear-gradient(135deg, color-mix(in srgb, ${color} 12%, transparent), color-mix(in srgb, ${color} 3%, transparent))`,
        border: `1px solid color-mix(in srgb, ${color} ${hover ? 55 : 22}%, transparent)`,
        borderRadius: 12,
        padding: '16px 20px',
        position: 'relative',
        overflow: 'hidden',
        cursor: clickable ? 'pointer' : 'default',
        transition: 'all 0.22s',
        transform: pressed ? 'scale(0.97)' : hover ? 'translateY(-2px)' : 'none',
        boxShadow: hover ? `0 8px 22px color-mix(in srgb, ${color} 26%, transparent)` : 'none',
        height: '100%',
        display: 'flex',
        flexDirection: 'column',
        minHeight: 120,
      }}>
      <div style={{
        position: 'absolute', top: -12, insetInlineEnd: -12,
        width: hover ? 80 : 56, height: hover ? 80 : 56,
        borderRadius: '50%',
        background: `radial-gradient(circle, color-mix(in srgb, ${color} ${hover ? 36 : 18}%, transparent), transparent 70%)`,
        pointerEvents: 'none', transition: 'all 0.3s',
      }} />

      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', position: 'relative', marginBottom: 8 }}>
        <div style={{
          fontSize: 18,
          filter: hover ? `drop-shadow(0 0 10px ${color})` : 'none',
          transition: 'filter 0.22s',
        }}>{icon}</div>
        <div style={{ fontSize: 11, color: 'var(--text)', opacity: 0.72, fontWeight: 600, letterSpacing: 0.3 }}>{label}</div>
      </div>

      <div style={{ position: 'relative', textAlign: 'center', flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
        <div style={{
          fontSize: valueFontSize,
          fontWeight: 800,
          color: color,
          lineHeight: 1.05,
          letterSpacing: -0.6,
          marginBottom: 4,
          fontVariantNumeric: 'tabular-nums',
          textShadow: hover ? `0 0 20px color-mix(in srgb, ${color} 45%, transparent)` : 'none',
          transition: 'text-shadow 0.22s, font-size 0.2s',
        }}>{value}</div>
        {sub ? <div style={{ fontSize: 12, color: 'var(--text)', opacity: 0.72, fontWeight: 500 }}>{sub}</div> : null}
      </div>
    </div>
  );
}

function InfoW({ data }: { data: DataShape }) {
  const [tick, setTick] = useState(0);
  useEffect(() => { const t = setInterval(() => setTick((x) => x + 1), 60000); return () => clearInterval(t); }, []);
  const w = data.weather;
  const pr = data.prayer;
  const news = data.news || [];
  const next = getNextPrayer(pr?.prayers);
  const hijriStr = pr?.hijri?.day ? `${pr.hijri.day} ${pr.hijri.month?.ar || ''}` : '';
  const gregStr = pr?.gregorian?.day ? `${pr.gregorian.day} ${pr.gregorian.month?.en || ''}` : '';
  const openLink = (u?: string) => { if (u && typeof window !== 'undefined') window.open(u, '_blank', 'noopener'); };

  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 10, height: '100%' }}>
      <InfoCard
        label={w?.city || 'الرياض'}
        value={w?.current?.temp != null ? `${w.current.temp}°` : '—'}
        sub={w?.current?.desc || 'الطقس'}
        color="#F59E0B"
        icon={'\u2600'}
      />
      <InfoCard
        label="الصلاة القادمة"
        value={next?.name || '—'}
        sub={next?.time || ''}
        color="#10B981"
        icon={'\u2726'}
      />
      <InfoCard
        label="التاريخ"
        value={hijriStr || gregStr || '—'}
        sub={gregStr && hijriStr ? gregStr : (pr?.hijri?.year ? `${pr.hijri.year}هـ` : '')}
        color="#8B5CF6"
        icon={'\u25C8'}
      />
    </div>
  );
}

function TaskRow({ t }: { t: any }) {
