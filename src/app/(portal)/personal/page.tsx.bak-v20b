function MiniChat({ userName }: { userName: string }) {
  const [messages, setMessages] = useState<{ role: 'user' | 'assistant'; content: string }[]>([]);
  const [input, setInput] = useState('');
  const [streaming, setStreaming] = useState(false);
  const [convId, setConvId] = useState<number | null>(null);
  const [model, setModel] = useState('auto');
  const [modelOpen, setModelOpen] = useState(false);
  const bodyRef = useRef<HTMLDivElement>(null);

  const C = {
    bg: '#070B1A',
    bgAccent: '#0B1023',
    bgElevated: '#101935',
    border: 'rgba(0, 209, 255, 0.15)',
    primary: '#00D1FF',
    primaryDark: '#00B8D9',
    text: '#EAF4FF',
    textMuted: '#A9B8D4',
    online: '#00FF88',
  };

  const MODELS = [
    { id: 'auto', label: 'Auto' },
    { id: 'gpt-5', label: 'GPT-5' },
    { id: 'claude', label: 'Claude' },
    { id: 'gemini', label: 'Gemini' },
    { id: 'local', label: 'Local' },
  ];

  useEffect(() => {
    bodyRef.current?.scrollTo({ top: bodyRef.current.scrollHeight, behavior: 'smooth' });
  }, [messages, streaming]);

  const send = async (text?: string) => {
    const msg = (text || input).trim();
    if (!msg || streaming) return;
    setInput('');
    setMessages((m) => [...m, { role: 'user', content: msg }, { role: 'assistant', content: '' }]);
    setStreaming(true);
    try {
      const body: any = { message: msg, model: model === 'auto' ? '__auto__' : model };
      if (convId) body.conversationId = convId;
      const res = await fetch('/api/assistant/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const errText = await res.text().catch(() => '');
        throw new Error('HTTP ' + res.status + (errText ? ': ' + errText.slice(0, 80) : ''));
      }
      if (!res.body) throw new Error('no response');
      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let buf = '';
      let asst = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const events = buf.split('\n\n');
        buf = events.pop() || '';
        for (const ev of events) {
          if (!ev.startsWith('data: ')) continue;
          try {
            const d = JSON.parse(ev.slice(6));
            if (d.type === 'text') {
              asst += d.text;
              setMessages((m) => {
                const copy = [...m];
                copy[copy.length - 1] = { role: 'assistant', content: asst };
                return copy;
              });
            } else if (d.type === 'meta' && d.conversationId) {
              setConvId(d.conversationId);
            }
          } catch {}
        }
      }
    } catch (e: any) {
      setMessages((m) => {
        const copy = [...m];
        copy[copy.length - 1] = { role: 'assistant', content: 'خطأ: ' + (e?.message || '') };
        return copy;
      });
    } finally {
      setStreaming(false);
    }
  };

  const newChat = () => { setMessages([]); setConvId(null); setInput(''); };

  const chips = ['لخص التقرير', 'أنشئ دراسة', 'اقترح أفكار', 'تحليل البيانات'];
  const isDisabled = streaming || !input.trim();
  const modelLabel = MODELS.find((m) => m.id === model)?.label || 'Auto';

  const containerStyle: React.CSSProperties = {
    margin: '0 0 16px 0',
    width: '100%',
    height: 420,
    background: C.bg,
    border: `1px solid ${C.border}`,
    borderRadius: 20,
    boxShadow: '0 0 40px rgba(0, 209, 255, 0.05), 0 12px 32px rgba(0, 0, 0, 0.45)',
    overflow: 'hidden',
    display: 'flex',
    flexDirection: 'column',
    position: 'relative',
  };

  const headerStyle: React.CSSProperties = {
    padding: '12px 16px',
    background: `linear-gradient(180deg, ${C.bgAccent}, ${C.bg})`,
    borderBottom: `1px solid ${C.border}`,
    display: 'flex',
    alignItems: 'center',
    gap: 10,
  };

  const avatarStyle: React.CSSProperties = {
    width: 36, height: 36, borderRadius: '50%',
    background: `radial-gradient(circle at 30% 30%, ${C.primary}, ${C.primaryDark})`,
    boxShadow: '0 0 12px rgba(0, 209, 255, 0.45)',
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    color: '#001122', fontWeight: 800, fontSize: 16, flexShrink: 0,
  };

  const ghostBtn: React.CSSProperties = {
    width: 32, height: 32, borderRadius: 8,
    background: 'transparent',
    border: `1px solid ${C.border}`,
    color: C.textMuted,
    fontSize: 13,
    cursor: 'pointer',
    flexShrink: 0,
  };

  const topGlowStyle: React.CSSProperties = {
    position: 'absolute',
    top: 0, left: '20%', right: '20%',
    height: 1,
    background: `linear-gradient(90deg, transparent, ${C.primary}, transparent)`,
    opacity: 0.5,
    pointerEvents: 'none',
  };

  const titleStyle: React.CSSProperties = {
    color: C.text, fontWeight: 700, fontSize: 14,
    display: 'flex', alignItems: 'center', gap: 6,
  };

  const onlineStyle: React.CSSProperties = {
    width: 7, height: 7, borderRadius: '50%',
    background: C.online,
    boxShadow: `0 0 8px ${C.online}`,
    display: 'inline-block',
  };

  const modelBtnStyle: React.CSSProperties = {
    padding: '5px 10px',
    background: 'rgba(0, 209, 255, 0.08)',
    border: `1px solid ${C.border}`,
    borderRadius: 8,
    color: C.text,
    fontSize: 11,
    cursor: 'pointer',
    display: 'flex',
    alignItems: 'center',
    gap: 4,
  };

  const dropdownStyle: React.CSSProperties = {
    position: 'absolute',
    top: 'calc(100% + 4px)',
    insetInlineEnd: 0,
    background: C.bgElevated,
    border: `1px solid ${C.border}`,
    borderRadius: 8,
    padding: 4,
    minWidth: 110,
    zIndex: 20,
    boxShadow: '0 8px 24px rgba(0,0,0,0.5)',
  };

  const openFullStyle: React.CSSProperties = {
    width: 28, height: 28,
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    background: 'transparent',
    border: `1px solid ${C.border}`,
    borderRadius: 8,
    color: C.textMuted,
    textDecoration: 'none',
    fontSize: 12,
    flexShrink: 0,
  };

  const messagesAreaStyle: React.CSSProperties = {
    flex: 1, padding: '14px 16px', overflow: 'auto', background: C.bg,
    display: 'flex', flexDirection: 'column', gap: 10,
  };

  const emptyStateStyle: React.CSSProperties = {
    flex: 1, display: 'flex', flexDirection: 'column',
    alignItems: 'center', justifyContent: 'center',
    textAlign: 'center', color: C.textMuted, fontSize: 13, padding: 16,
  };

  const emptyIconStyle: React.CSSProperties = {
    width: 56, height: 56, borderRadius: '50%',
    background: 'radial-gradient(circle, rgba(0, 209, 255, 0.18), transparent)',
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    fontSize: 28, color: C.primary, marginBottom: 10,
  };

  const chipsStyle: React.CSSProperties = {
    padding: '8px 16px',
    borderTop: `1px solid ${C.border}`,
    background: C.bgAccent,
    display: 'flex', gap: 6, flexWrap: 'wrap',
  };

  const chipStyle: React.CSSProperties = {
    padding: '5px 10px',
    background: 'rgba(0, 209, 255, 0.06)',
    border: `1px solid ${C.border}`,
    borderRadius: 100,
    color: C.textMuted,
    fontSize: 11,
    cursor: 'pointer',
    whiteSpace: 'nowrap',
  };

  const inputFormStyle: React.CSSProperties = {
    padding: '10px 12px',
    background: C.bgAccent,
    borderTop: `1px solid ${C.border}`,
    display: 'flex', gap: 6, alignItems: 'center',
  };

  const inputStyle: React.CSSProperties = {
    flex: 1, padding: '8px 12px',
    background: 'rgba(0, 209, 255, 0.04)',
    border: `1px solid ${C.border}`,
    borderRadius: 10,
    color: C.text, fontSize: 13, outline: 'none',
  };

  const sendBtnStyle: React.CSSProperties = {
    width: 36, height: 36, borderRadius: 10,
    background: isDisabled ? 'rgba(0, 209, 255, 0.15)' : `linear-gradient(135deg, ${C.primaryDark}, ${C.primary})`,
    border: 'none',
    color: isDisabled ? C.textMuted : '#001122',
    fontWeight: 800, fontSize: 14,
    cursor: isDisabled ? 'not-allowed' : 'pointer',
    boxShadow: isDisabled ? 'none' : '0 0 12px rgba(0, 209, 255, 0.3)',
    flexShrink: 0,
  };

  return (
    <div style={containerStyle}>
      <div style={topGlowStyle} />
      <div style={headerStyle}>
        <div style={avatarStyle}>{'\u2726'}</div>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={titleStyle}>
            المساعد الذكي
            <span style={onlineStyle} />
          </div>
          <div style={{ color: C.textMuted, fontSize: 11 }}>
            {streaming ? 'يكتب الآن...' : 'متصل · جاهز'}
          </div>
        </div>
        <div style={{ position: 'relative' }}>
          <button type="button" onClick={() => setModelOpen((o) => !o)} style={modelBtnStyle}>
            {modelLabel}
            <span style={{ fontSize: 8 }}>{'\u25BE'}</span>
          </button>
          {modelOpen ? (
            <div style={dropdownStyle}>
              {MODELS.map((mm) => (
                <button key={mm.id} type="button" onClick={() => { setModel(mm.id); setModelOpen(false); }} style={{
                  display: 'block', width: '100%', padding: '6px 10px',
                  background: mm.id === model ? 'rgba(0, 209, 255, 0.12)' : 'transparent',
                  border: 'none', borderRadius: 6,
                  color: mm.id === model ? C.primary : C.textMuted,
                  fontSize: 12, cursor: 'pointer', textAlign: 'right',
                }}>{mm.label}</button>
              ))}
            </div>
          ) : null}
        </div>
        <a href={convId ? `/assistant?cid=${convId}` : '/assistant'} title="افتح كامل" style={openFullStyle}>{'\u2197'}</a>
      </div>

      <div ref={bodyRef} style={messagesAreaStyle}>
        {messages.length === 0 ? (
          <div style={emptyStateStyle}>
            <div style={emptyIconStyle}>{'\u2726'}</div>
            <div style={{ color: C.text, fontWeight: 600, fontSize: 14, marginBottom: 4 }}>
              أهلاً {userName}
            </div>
            <div style={{ fontSize: 12 }}>اسألني عن البرامج، الفريق، أو الترشيحات</div>
          </div>
        ) : (
          messages.map((m, i) => (
            <div key={i} style={{ display: 'flex', justifyContent: m.role === 'user' ? 'flex-start' : 'flex-end' }}>
              <div style={{
                background: m.role === 'user' ? `linear-gradient(135deg, ${C.primaryDark}, ${C.primary})` : 'rgba(0, 209, 255, 0.05)',
                border: m.role === 'user' ? 'none' : `1px solid ${C.border}`,
                padding: '8px 12px',
                borderRadius: m.role === 'user' ? '12px 4px 12px 12px' : '4px 12px 12px 12px',
                color: m.role === 'user' ? '#001122' : C.text,
                fontSize: 13, maxWidth: '78%',
                whiteSpace: 'pre-wrap', wordBreak: 'break-word',
                boxShadow: m.role === 'user' ? '0 2px 10px rgba(0, 209, 255, 0.22)' : 'none',
                fontWeight: m.role === 'user' ? 600 : 400, lineHeight: 1.55,
              }}>
                {m.content || (streaming && i === messages.length - 1 ? '...' : '')}
              </div>
            </div>
          ))
        )}
      </div>

      {messages.length === 0 ? (
        <div style={chipsStyle}>
          {chips.map((c) => (
            <button key={c} type="button" onClick={() => send(c)} style={chipStyle}>{c}</button>
          ))}
        </div>
      ) : null}

      <form onSubmit={(e) => { e.preventDefault(); send(); }} style={inputFormStyle}>
        <button type="button" onClick={newChat} title="محادثة جديدة" style={ghostBtn}>{'\u21BB'}</button>
        <button type="button" title="رفع ملف" style={ghostBtn}>{'\uD83D\uDCCE'}</button>
        <button type="button" title="صوت" style={ghostBtn}>{'\uD83C\uDFA4'}</button>
        <input value={input} onChange={(e) => setInput(e.target.value)} placeholder="اكتب سؤالك..." disabled={streaming} autoComplete="off" style={inputStyle} />
        <button type="submit" disabled={isDisabled} title="إرسال" style={sendBtnStyle}>{streaming ? '...' : '\u2192'}</button>
      </form>
    </div>
  );
}
