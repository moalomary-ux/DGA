  return (
    <div onClick={open} onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)} style={{
      background: hover
        ? `linear-gradient(135deg, color-mix(in srgb, ${color} 24%, transparent), color-mix(in srgb, ${color} 8%, transparent))`
        : `linear-gradient(135deg, color-mix(in srgb, ${color} 10%, transparent), color-mix(in srgb, ${color} 3%, transparent))`,
      border: `1px solid color-mix(in srgb, ${color} ${hover ? 55 : 22}%, transparent)`,
      borderRadius: 12, padding: 14,
      cursor: n.link ? 'pointer' : 'default',
      transition: 'all 0.22s',
      transform: hover ? 'translateY(-3px)' : 'none',
      boxShadow: hover ? `0 10px 26px color-mix(in srgb, ${color} 30%, transparent)` : 'none',
      display: 'flex', flexDirection: 'column', height: '100%', minHeight: 0,
      position: 'relative', overflow: 'hidden', userSelect: 'none',
    }}>
      <div style={{
        position: 'absolute', top: -14, insetInlineEnd: -14,
        width: 70, height: 70, borderRadius: '50%',
        background: `radial-gradient(circle, color-mix(in srgb, ${color} ${hover ? 38 : 18}%, transparent), transparent 70%)`,
        pointerEvents: 'none', transition: 'all 0.3s',
      }} />
      <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginBottom: 10, position: 'relative' }}>
        <span style={{ width: 6, height: 6, borderRadius: '50%', background: color, boxShadow: hover ? `0 0 10px ${color}` : 'none', transition: 'box-shadow 0.2s' }} />
        <span style={{ fontSize: 10, color, fontWeight: 700, letterSpacing: 0.3 }}>{label}</span>
      </div>
      <div style={{ fontSize: 13, fontWeight: 600, color: 'var(--text)', lineHeight: 1.5, position: 'relative', display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>
        {n.title || '—'}
      </div>
      <div style={{ fontSize: 10, color: 'var(--text)', opacity: 0.55, marginTop: 'auto', paddingTop: 8, display: 'flex', justifyContent: 'space-between', alignItems: 'center', position: 'relative' }}>
        <span>{n.source || ''}</span>
        {n.link ? <span style={{ color }}>{'\u2197'}</span> : null}
      </div>
    </div>
  );
}

function NewsW({ data }: any) {
  const items = data.news || [];
