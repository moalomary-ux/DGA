import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';
export const revalidate = 600;

type FeedItem = { title: string; link: string; pubDate: string };

const CATEGORIES = [
  {
    id: 'politics', label: 'سياسة', color: '#EF4444',
    feeds: [
      { url: 'https://www.aljazeera.net/aljazeerarss/a7c186be-1baa-4bd4-9d80-a84db769f779/52bea22b-3a3d-487f-9fcf-7d0a8c8a2f56', source: 'الجزيرة' },
      { url: 'https://feeds.bbci.co.uk/arabic/middleeast/rss.xml', source: 'BBC العربية' },
      { url: 'https://feeds.bbci.co.uk/arabic/world/rss.xml', source: 'BBC العربية' },
    ],
  },
  {
    id: 'economy', label: 'اقتصاد', color: '#10B981',
    feeds: [
      { url: 'https://feeds.bbci.co.uk/arabic/business/rss.xml', source: 'BBC العربية' },
      { url: 'https://www.aljazeera.net/aljazeerarss/4f51f922-a4bb-43f8-948b-77b56fc11d8a/9aaf9af6-aa9a-4d99-b3f7-d8eb71a16ec4', source: 'الجزيرة' },
    ],
  },
  {
    id: 'tech', label: 'تقنية وذكاء اصطناعي', color: '#8B5CF6',
    feeds: [
      { url: 'https://feeds.bbci.co.uk/arabic/scitech/rss.xml', source: 'BBC العربية' },
      { url: 'https://techcrunch.com/feed/', source: 'TechCrunch' },
      { url: 'https://www.theverge.com/rss/index.xml', source: 'The Verge' },
    ],
  },
];

async function fetchRSS(url: string): Promise<FeedItem[]> {
  try {
    const res = await fetch(url, {
      signal: AbortSignal.timeout(8000),
      headers: { 'User-Agent': 'Mozilla/5.0 (compatible; QudratokBot/1.0)' },
    });
    if (!res.ok) return [];
    const xml = await res.text();
    const items: FeedItem[] = [];
    const itemRe = /<item[\s>][\s\S]*?<\/item>|<entry[\s>][\s\S]*?<\/entry>/g;
    let m;
    while ((m = itemRe.exec(xml)) !== null && items.length < 15) {
      const block = m[0];
      const titleM = block.match(/<title[^>]*>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/title>/);
      const linkM = block.match(/<link[^>]*>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/link>/)
                  || block.match(/<link[^>]+href="([^"]+)"/);
      const pubM = block.match(/<pubDate>([\s\S]*?)<\/pubDate>/)
                || block.match(/<published>([\s\S]*?)<\/published>/);
      const t = titleM ? titleM[1].trim().replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>') : '';
      const l = linkM ? linkM[1].trim() : '';
      if (t && l) items.push({ title: t, link: l, pubDate: pubM ? pubM[1].trim() : '' });
    }
    return items;
  } catch (e) {
    return [];
  }
}

function isLive(link: string): boolean {
  return link.includes('/live/') || link.includes('/live-news/');
}

export async function GET() {
  const usedLinks = new Set<string>();
  const usedTitles = new Set<string>();
  const results: any[] = [];

  for (const cat of CATEGORIES) {
    let picked: any = null;
    for (const f of cat.feeds) {
      const items = await fetchRSS(f.url);
      const fresh = items.find((it) =>
        it.link &&
        !usedLinks.has(it.link) &&
        !usedTitles.has(it.title) &&
        !isLive(it.link)
      );
      if (fresh) {
        usedLinks.add(fresh.link);
        usedTitles.add(fresh.title);
        picked = {
          category: cat.id, label: cat.label, color: cat.color,
          source: f.source, title: fresh.title, link: fresh.link, pubDate: fresh.pubDate,
        };
        break;
      }
    }
    if (picked) results.push(picked);
  }

  return NextResponse.json({ ok: true, items: results, fetched_at: new Date().toISOString() });
}
