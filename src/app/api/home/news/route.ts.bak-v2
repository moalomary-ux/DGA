import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';
export const revalidate = 600; // 10 min cache

type FeedItem = { title: string; link: string; pubDate: string };

// Real Arabic news sources by category — multiple feeds with fallback
const CATEGORIES = [
  {
    id: 'politics',
    label: 'سياسة',
    color: '#EF4444',
    feeds: [
      { url: 'https://feeds.bbci.co.uk/arabic/middleeast/rss.xml', source: 'BBC العربية' },
      { url: 'https://feeds.bbci.co.uk/arabic/world/rss.xml',       source: 'BBC العربية' },
    ],
  },
  {
    id: 'economy',
    label: 'اقتصاد',
    color: '#10B981',
    feeds: [
      { url: 'https://feeds.bbci.co.uk/arabic/business/rss.xml', source: 'BBC العربية' },
    ],
  },
  {
    id: 'tech',
    label: 'تقنية وذكاء اصطناعي',
    color: '#8B5CF6',
    feeds: [
      { url: 'https://feeds.bbci.co.uk/arabic/scitech/rss.xml', source: 'BBC العربية' },
    ],
  },
];

async function fetchRSS(url: string): Promise<FeedItem[]> {
  try {
    const res = await fetch(url, {
      signal: AbortSignal.timeout(8000),
      headers: { 'User-Agent': 'Mozilla/5.0 (compatible; QudratokBot/1.0)' },
    });
    if (!res.ok) return [];
    const xml = await res.text();
    const items: FeedItem[] = [];
    const itemRe = /<item[\s>][\s\S]*?<\/item>/g;
    let m;
    while ((m = itemRe.exec(xml)) !== null && items.length < 8) {
      const block = m[0];
      const titleM = block.match(/<title>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/title>/);
      const linkM = block.match(/<link>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/link>/);
      const pubM = block.match(/<pubDate>([\s\S]*?)<\/pubDate>/);
      const t = titleM ? titleM[1].trim().replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'") : '';
      const l = linkM ? linkM[1].trim() : '';
      if (t && l) items.push({ title: t, link: l, pubDate: pubM ? pubM[1].trim() : '' });
    }
    return items;
  } catch (e) {
    return [];
  }
}

export async function GET() {
  const results = await Promise.all(
    CATEGORIES.map(async (cat) => {
      for (const f of cat.feeds) {
        const items = await fetchRSS(f.url);
        if (items.length > 0) {
          return {
            category: cat.id,
            label: cat.label,
            color: cat.color,
            source: f.source,
            title: items[0].title,
            link: items[0].link,
            pubDate: items[0].pubDate,
          };
        }
      }
      return null;
    })
  );
  const items = results.filter(Boolean);
  return NextResponse.json({ ok: true, items, fetched_at: new Date().toISOString() });
}
