export function buildNav(tenantId: TenantId, isMaster: boolean, isSuperAdmin: boolean): NavGroup[] {
  const config = NAV_BY_TENANT[tenantId];
  return [
    ...config.base,
    ...(isMaster && config.master ? config.master : []),
    ...(isSuperAdmin && config.superAdmin ? config.superAdmin : []),
  ];
}
