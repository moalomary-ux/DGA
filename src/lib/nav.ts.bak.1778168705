import type { TenantId } from '@/lib/db';

export type IconName =
  | 'LayoutDashboard' | 'Briefcase' | 'User' | 'Sparkles' | 'Bot' | 'Users'
  | 'CheckSquare' | 'Settings' | 'Shield' | 'GraduationCap' | 'Award'
  | 'Handshake' | 'FileText' | 'Building2' | 'BookOpen' | 'NotebookPen'
  | 'Lightbulb' | 'Target' | 'Library' | 'Calendar' | 'Layers' | 'Inbox' | 'Cog' | 'Database' | 'Mail' | 'MessageCircle' | 'Plug';

export interface NavItem {
  href: string;
  label: string;
  icon: IconName;
}

export interface NavGroup {
  label: string;
  items: NavItem[];
}

export interface NavConfig {
  base: NavGroup[];
  master?: NavGroup[];
  superAdmin?: NavGroup[];
}

