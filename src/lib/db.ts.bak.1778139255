import postgres from 'postgres';

const connectionString = process.env.DATABASE_URL;

if (!connectionString) {
  throw new Error('DATABASE_URL is not set in environment');
}

const globalForDb = globalThis as unknown as { db?: ReturnType<typeof postgres> };

export const db =
  globalForDb.db ??
  postgres(connectionString, {
    max: 10,
    idle_timeout: 20,
    connect_timeout: 10,
  });

if (process.env.NODE_ENV !== 'production') {
  globalForDb.db = db;
}

export type UserStatus = 'active' | 'pending' | 'rejected' | 'suspended';
export type Role = 'super_admin' | 'admin' | 'editor' | 'viewer';
export type TenantId = 'omary' | 'advice' | 'qtech';

export interface User {
  id: string;
  email: string;
  name_ar: string;
  name_en: string | null;
  position: string | null;
  status: UserStatus;
  is_active: boolean;
  last_login_at: Date | null;
  created_at: Date;
}

export interface Membership {
  id: string;
  user_id: string;
  tenant_id: TenantId;
  role: Role;
  created_at: Date;
}

export interface AuthCode {
  id: string;
  user_id: string;
  tenant_id: TenantId;
  code_hash: string;
  expires_at: Date;
  used_at: Date | null;
  attempts: number;
  ip_address: string | null;
  created_at: Date;
}

export interface RegistrationRequest {
  id: number;
  email: string;
  name_ar: string;
  position: string | null;
  notes: string | null;
  tenant_id: TenantId;
  invite_code: string | null;
  status: 'pending' | 'approved' | 'rejected';
  reviewed_by: string | null;
  reviewed_at: Date | null;
  created_at: Date;
}

export interface InviteCode {
  id: number;
  code: string;
  tenant_id: TenantId;
  default_role: Role;
  max_uses: number;
  used_count: number;
  expires_at: Date | null;
  notes: string | null;
  created_by: string;
  created_at: Date;
}

export interface Contact {
  id: number;
  name_ar: string;
  name_en: string | null;
  email: string | null;
  phone: string | null;
  organization: string | null;
  department: string | null;
  position: string | null;
  relationship: string | null;
  scope: string | null;
  importance: number;
}
